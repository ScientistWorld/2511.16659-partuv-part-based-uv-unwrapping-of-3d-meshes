# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything a scientist agent needs to work on
# this paper's task. The agent's workspace is bind-mounted at /home/user
# at runtime — it is NOT baked into the container.
#
# Security boundary:
#   - test_labels and test_final_state.py NEVER enter the container
#   - solution/ NEVER enters the container
#   - Only training data and test features are included
#
# *** IMPORTANT ***
# Python packages (torch, transformers, etc.) go in setup.sh, NOT here.
# Only OS-level packages (apt-get) belong in %post.
# Putting pip install in %post is the #1 cause of build failures.

Bootstrap: scratch

%setup
    mkdir -p "$APPTAINER_ROOTFS"
    curl -L https://partner-images.canonical.com/core/jammy/current/ubuntu-jammy-core-cloudimg-amd64-root.tar.gz \
      | tar -xz --no-same-owner --no-same-permissions -C "$APPTAINER_ROOTFS"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        python3 \
        python3-pip
    ln -sf /usr/bin/python3 /usr/local/bin/python
    ln -sf /usr/bin/pip3 /usr/local/bin/pip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    set -e
    export TMPDIR=/dev/shm
    export UV_CACHE_DIR=/dev/shm/uv-cache
    
    cd /home/user
    
    if ! command -v uv >/dev/null 2>&1; then
      uv pip install uv
    fi
    
    uv pip install --system -U pip setuptools wheel
    uv pip install --system cmake ninja scikit-build-core "pybind11[global]"
    
    # Use prebuilt wheels where available to avoid compiling PartUV from source.
    # Torch keeps the CUDA 12.8 runtime in Python wheels, so the base image does
    # not need to provide a CUDA toolkit.
    uv pip install --system torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128
    uv pip install --system /home/user/environment/wheels/torch_scatter-2.1.2+pt27cu128-cp312-cp312-linux_x86_64.whl
    
    uv pip install --system \
      boto3 \
      h5py \
      libigl \
      lightning==2.2 \
      loguru \
      meshio \
      open3d \
      opencv-python \
      pandas \
      plyfile \
      pyyaml \
      scikit-image \
      scikit-learn \
      seaborn \
      tqdm \
      trimesh==4.9.0 \
      xatlas \
      yacs \
      einops
    
    uv pip install --system /home/user/environment/wheels/partuv-0.1.2-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PATH=/usr/local/bin:/usr/bin:$PATH
