# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# Uses scratch bootstrap with Ubuntu rootfs downloaded at build time.
# OS packages installed in %post. Python packages installed via setup.sh.

Bootstrap: scratch

%setup
    mkdir -p "$APPTAINER_ROOTFS"
    curl -sSL https://partner-images.canonical.com/core/jammy/current/ubuntu-jammy-core-cloudimg-amd64-root.tar.gz \
      | tar --numeric-owner -xz --no-same-owner --no-same-permissions -C "$APPTAINER_ROOTFS"
    # Copy wheel files into the container rootfs from the build context.
    # The build context is the directory containing container.def (environment/).
    cp -r wheels "$APPTAINER_ROOTFS/wheels"

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Install OS packages only. Python packages go in setup.sh.
    apt-get update
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        ca-certificates \
        curl \
        gnupg \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        wget
    apt-get clean
    rm -rf /var/lib/apt/lists/var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user

    # Create pip symlink so setup.sh can use pip3 consistently
    ln -sf /usr/bin/python3 /usr/local/bin/python

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PATH=/usr/local/bin:/usr/bin:$PATH
    export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
    export TMPDIR=/dev/shm
