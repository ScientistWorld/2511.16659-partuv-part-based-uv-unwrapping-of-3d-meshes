# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# Uses nvidia/cuda Docker image as base (has CUDA runtime).
# OS packages installed in %post. Python packages in setup.sh.
# Note: setup.sh runs at job runtime in overlay with full network access.

Bootstrap: docker
From: nvidia/cuda:12.8.0-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # OS packages only — Python packages go in setup.sh
    apt-get update
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        software-properties-common \
        wget
    apt-get clean
    rm -rf /var/lib/apt/lists/var/lib/apt/lists/*

    mkdir -p /home/user/data /home/user/checkpoints/partfield /home/user/checkpoints/xatlas_repro /home/user/checkpoints/partuv_repro
    chmod 755 /home/user

    # Install Python 3.12 from deadsnakes (needed for torch_scatter cp312 wheel)
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv

    # Create venv with Python 3.12
    python3.12 -m venv /opt/venv
    ln -sf /opt/venv/bin/python /usr/local/bin/python
    ln -sf /opt/venv/bin/python /usr/local/bin/python3

    # Upgrade pip in venv (setup.sh will use this)
/opt/venv/bin/pip install --no-cache-dir -U pip wheel

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:$PATH
    export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
    export TMPDIR=/dev/shm
