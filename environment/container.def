# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# Uses nvidia/cuda Docker image as base (has CUDA runtime).
# Creates a venv to avoid system-package conflicts.
# All wheels downloaded from the internet during %post.

Bootstrap: docker
From: nvidia/cuda:12.8.0-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Install OS packages
    apt-get update
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user

    # Create a fresh venv to install all Python packages cleanly
    set -e
    export TMPDIR=/dev/shm

    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir -U pip wheel

    # Install build tools
    /opt/venv/bin/pip install --no-cache-dir cmake ninja scikit-build-core "pybind11[global]"

    # PyTorch with CUDA 12.8
    /opt/venv/bin/pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128

    # torch_scatter from PyG's wheel index
    /opt/venv/bin/pip install --no-cache-dir \
        https://data.pyg.org/whl/torch-2.7.0+cu128/torch_scatter-2.1.2+pt27cu128-cp312-cp312-linux_x86_64.whl

    # Scientific Python stack
    /opt/venv/bin/pip install --no-cache-dir \
        boto3 \
        h5py \
        libigl \
        lightning==2.2 \
        loguru \
        meshio \
        open3d \
        opencv-python \
        pandas \
        plyfile \
        pyyaml \
        scikit-image \
        scikit-learn \
        seaborn \
        tqdm \
        trimesh==4.9.0 \
        xatlas \
        yacs \
        einops

    # PartUV from PyPI
    /opt/venv/bin/pip install --no-cache-dir partuv==0.1.2

    # Make venv python the default
    ln -sf /opt/venv/bin/python /usr/local/bin/python
    ln -sf /opt/venv/bin/python /usr/local/bin/python3

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:$PATH
    export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6
    export TMPDIR=/dev/shm
